# ============================================================
# VARIÁVEIS DE AMBIENTE — sistema-menino-do-alho (Flask)
# ============================================================
# Copie para .env e preencha. NUNCA commite .env no git.
# No Render: configure estas variáveis em:
#   Dashboard > sistema-menino-do-alho > Environment > Environment Variables

# ── AUTENTICAÇÃO DOS BOTS EXTERNOS ─────────────────────────
# Token para a rota POST /api/bot/upload (bot Node.js / entregador.py)
# DEVE ser idêntico ao API_BOT_TOKEN configurado no bot-boletos.
API_BOT_TOKEN=ALHO_BOT_SUPER_SECRETO_2026_XYZ

# Token para a rota POST /upload (robôs legados que usam Authorization header)
API_TOKEN=ALHO_BOT_SUPER_SECRETO_2026_XYZ

# ── BANCO DE DADOS ──────────────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@host/banco

# ── CLOUDINARY (armazenamento de PDFs) ─────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── FLASK ───────────────────────────────────────────────────
SECRET_KEY=coloque_uma_chave_secreta_longa_aqui
FLASK_ENV=production

# ── RENDER ──────────────────────────────────────────────────
# (Render define PORT automaticamente — não precisa setar manualmente)
